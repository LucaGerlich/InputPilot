<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSInputMonitoringUsageDescription</key>
	<string>InputPilot detects which keyboard you are typing on to switch your input language automatically. It never reads or stores what you type.</string>
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/LucaGerlich/InputPilot/main/appcast.xml</string>
	<!-- EdDSA public key; the matching private key lives in the release
	     machine's Keychain. Never set this to an empty string - an empty key
	     is invalid and makes Sparkle abort with a fatal updater error. -->
	<key>SUPublicEDKey</key>
	<string>pssjO3kU2/CHGn3oOa4atzbvmFbwind07K8GZIuqOpY=</string>
	<!-- Set explicitly so Sparkle skips its first-launch permission dialog. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
</dict>
</plist>
